# ===================================
# F1 Race Replay Environment Variables
# ===================================

# Backend Configuration (Railway / Render / Local)
FASTF1_CACHE_DIR=./assets/cache
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=https://f1-race-replay.vercel.app
REDIS_URL=redis://localhost:6379/0
PORT=8000

# Frontend Configuration (Vercel / Local)
# Use NEXT_PUBLIC_API_URL for production REST endpoint (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional: only if WebSocket URL differs from REST host (e.g. wss://api.yourdomain.com)
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
